            const scenario = scenariosData.find(s => s.id === id);
            if (!scenario) return;

            document.getElementById('player-title').innerText = `${scenario.id}. ${scenario.title}`;
            document.getElementById('player-category').innerText = scenario.category;
            document.getElementById('player-desc').innerText = `摘要：${scenario.summary}`;

            renderCurrentDialogue();
