        function filterScenarios() {
            const query = document.getElementById('scenario-search').value.toLowerCase();
            const cat = document.getElementById('category-filter').value;

            const filtered = scenariosData.filter(item => {
                const matchesQuery = item.title.toLowerCase().includes(query) || 
                                     item.summary.toLowerCase().includes(query) ||
                                     item.lines.some(l => l.en.toLowerCase().includes(query));
                const matchesCat = (cat === 'ALL') || item.category.includes(cat);
                return matchesQuery && matchesCat;
            });

            renderScenarioList(filtered);
        }

