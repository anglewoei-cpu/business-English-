        function renderCurrentDialogue() {
            const scenario = scenariosData.find(s => s.id === currentScenarioId);
            if (!scenario) return;

            const showEn = document.getElementById('toggle-en').checked;
            const showZh = document.getElementById('toggle-zh').checked;
            const container = document.getElementById('dialogue-lines-list');
            container.innerHTML = '';

            scenario.lines.forEach((line, idx) => {
                const isSpeakerA = line.speaker === 'A';
                const bgClass = isSpeakerA ? 'bg-white border-slate-200' : 'bg-indigo-50/50 border-indigo-100';
                const badgeClass = isSpeakerA ? 'bg-indigo-600 text-white' : 'bg-emerald-600 text-white';

                const lineDiv = document.createElement('div');
                lineDiv.className = `p-3.5 rounded-xl border ${bgClass} transition flex items-start justify-between gap-3 group`;

                lineDiv.innerHTML = `
                    <div class="flex items-start gap-3 flex-1">
                        <span class="px-2.5 py-1 rounded-md font-bold text-xs ${badgeClass} shrink-0 mt-0.5">${line.speaker}</span>
