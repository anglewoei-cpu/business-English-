                    </div>
                    <button onclick="speakText('${escapeHtml(line.en.replace(/'/g, "\\'"))}')" title="單句朗讀" 
                            class="p-2 text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 rounded-lg transition shrink-0">
                        <i class="fa-solid fa-volume-high text-sm"></i>
                    </button>
                `;
                container.appendChild(lineDiv);
            });
        }

        function speakText(text) {
            stopSpeech();
            if (!('speechSynthesis' in window)) {
                alertModal("您的瀏覽器不支援 Web Speech 語音合成。");
                return;
            }
            const utterance = new SpeechSynthesisUtterance(text);
            utterance.lang = 'en-US';
            utterance.rate = speechRate;
            synth.speak(utterance);
        }

        function playFullDialogue() {
            stopSpeech();
            const scenario = scenariosData.find(s => s.id === currentScenarioId);
            if (!scenario) return;

            let lineIndex = 0;
            function speakNext() {
                if (lineIndex >= scenario.lines.length) return;
                const line = scenario.lines[lineIndex];
                const utterance = new SpeechSynthesisUtterance(line.en);
                utterance.lang = 'en-US';
                utterance.rate = speechRate;
                utterance.onend = function() {
                    lineIndex++;
                    speakNext();
                };
                synth.speak(utterance);
            }
            speakNext();
        }

        function stopSpeech() {
            if (synth.speaking) {
                synth.cancel();
            }
        }

