        function gradeQuiz() {
            let correctCount = 0;
            const total = quizQuestionsData.length;

            quizQuestionsData.forEach(q => {
                const selected = document.querySelector(`input[name="quiz-${q.id}"]:checked`);
                const expBox = document.getElementById(`explanation-${q.id}`);
                expBox.classList.remove('hidden', 'bg-emerald-50', 'text-emerald-800', 'border-emerald-200', 'bg-rose-50', 'text-rose-800', 'border-rose-200');

                if (selected && selected.value === q.answer) {
                    correctCount++;
                    expBox.classList.add('bg-emerald-50', 'text-emerald-800', 'border', 'border-emerald-200');
                    expBox.innerHTML = `<i class="fa-solid fa-circle-check text-emerald-600 mr-1"></i> <strong>回答正確！</strong> ${q.explanation}`;
                } else {
                    expBox.classList.add('bg-rose-50', 'text-rose-800', 'border', 'border-rose-200');
                    expBox.innerHTML = `<i class="fa-solid fa-circle-xmark text-rose-600 mr-1"></i> <strong>回答錯誤！正確答案為 (${q.answer})。</strong> ${q.explanation}`;
                }
            });

            const score = Math.round((correctCount / total) * 100);
            document.getElementById('quiz-score-display').innerText = `${score} / 100`;

            const banner = document.getElementById('quiz-feedback-banner');
            banner.classList.remove('hidden', 'bg-emerald-100', 'text-emerald-900', 'bg-amber-100', 'text-amber-900');
            if (score >= 80) {
                banner.classList.add('bg-emerald-100', 'text-emerald-900');
                banner.innerHTML = `<i class="fa-solid fa-trophy text-amber-500 text-base mr-1.5"></i> 恭喜得分 ${score} 分！您已掌握外貿實務關鍵溝通與用語。`;
            } else {
                banner.classList.add('bg-amber-100', 'text-amber-900');
                banner.innerHTML = `<i class="fa-solid fa-circle-info text-amber-600 text-base mr-1.5"></i> 得分 ${score} 分。建議可複習下方標紅解析與情境對話！`;
            }
        }

